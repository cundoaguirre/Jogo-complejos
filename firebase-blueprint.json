{
  "entities": {
    "Complejo": {
      "title": "Complejo",
      "description": "Documento central de la sede deportiva con array inmutable de canchas",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador del complejo"
        },
        "name": {
          "type": "string",
          "maxLength": 150,
          "description": "Nombre de la sede deportiva"
        },
        "company": {
          "type": "string",
          "maxLength": 150,
          "description": "Razón social o empresa del complejo"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Teléfono de contacto de la sede"
        },
        "address": {
          "type": "string",
          "maxLength": 250,
          "description": "Dirección física de la sede"
        },
        "instagram": {
          "type": "string",
          "maxLength": 100,
          "description": "Handle de Instagram del complejo"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Descripción general del complejo"
        },
        "courts": {
          "type": "array",
          "description": "Array inmutable de canchas dentro del complejo",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Identificador alfanumérico único de la cancha"
              },
              "name": {
                "type": "string",
                "maxLength": 100,
                "description": "Nombre provisto en el formulario"
              },
              "sport": {
                "type": "string",
                "enum": ["fútbol 5", "fútbol 6", "fútbol 7", "fútbol 8", "fútbol 9", "fútbol 11"],
                "description": "Deporte correspondiente"
              },
              "surface": {
                "type": "string",
                "description": "Tipo de superficie (sintético, cemento, césped, blindex, tierra, arena)"
              },
              "price": {
                "type": "number",
                "description": "Valor de la hora parseado del formulario"
              },
              "status": {
                "type": "string",
                "enum": ["activa", "mantenimiento", "inactiva"],
                "description": "Estado operativo de la cancha"
              }
            },
            "required": ["id", "name", "sport", "surface", "price", "status"]
          }
        },
        "updatedAt": {
          "type": "string",
          "description": "Marca de tiempo de última actualización"
        }
      },
      "required": ["name", "courts"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Reserva de cancha con clave de enlace complejoId",
      "type": "object",
      "properties": {
        "complejoId": {
          "type": "string",
          "description": "ID del complejo activo (estricto en español)"
        },
        "complejoName": {
          "type": "string",
          "description": "Nombre del complejo activo"
        },
        "courtName": {
          "type": "string",
          "description": "Nombre de la cancha seleccionada"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Fecha en formato YYYY-MM-DD"
        },
        "startTime": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$",
          "description": "Horario de inicio HH:mm"
        },
        "endTime": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$",
          "description": "Horario de fin HH:mm"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duración en minutos calculada"
        },
        "price": {
          "type": "number",
          "description": "Monto total acordado"
        },
        "deposit": {
          "type": "number",
          "description": "Seña abonada (0 si no aplica)"
        },
        "status": {
          "type": "string",
          "enum": ["confirmado", "cancelado", "jugado"],
          "description": "Estado operativo del turno"
        },
        "paymentStatus": {
          "type": "string",
          "description": "Estado del pago (pendiente, seña, pagado)"
        },
        "userId": {
          "type": "string",
          "description": "ID del jugador en users, o '0' si es cliente temporal"
        },
        "userName": {
          "type": "string",
          "description": "Nombre del cliente"
        },
        "userPhone": {
          "type": "string",
          "description": "Teléfono del cliente"
        },
        "userEmail": {
          "type": "string",
          "description": "Email del cliente"
        },
        "notes": {
          "type": "string",
          "description": "Observaciones operativas cargadas por el operador"
        },
        "ownerId": {
          "type": "string",
          "description": "UID de Google Auth del operador"
        },
        "adminId": {
          "type": "string",
          "description": "ID de control o cadena vacía"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp ISO de creación"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp ISO de última edición"
        }
      },
      "required": ["complejoId", "courtName", "date", "startTime", "endTime", "price", "status"]
    },
    "User": {
      "title": "User",
      "description": "Jugadores y clientes finales del complejo deportivo",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID del documento del cliente"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Nombre y apellido del cliente provisto en input"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Teléfono provisto en input"
        },
        "email": {
          "type": "string",
          "description": "Correo electrónico provisto en input"
        },
        "gender": {
          "type": "string",
          "description": "Género seleccionado explícitamente en el desplegable"
        },
        "city": {
          "type": "string",
          "description": "Ciudad o localidad provista en input"
        },
        "category": {
          "type": "string",
          "description": "Categoría de cliente (jugador, capitán)"
        },
        "status": {
          "type": "string",
          "description": "Estado inicial de negocio"
        },
        "isActivated": {
          "type": "boolean",
          "description": "Indica si el cliente interactuó en canales digitales"
        },
        "acquisitionChannel": {
          "type": "string",
          "description": "Canal de adquisición seleccionado en desplegable"
        },
        "acquisitionDate": {
          "type": "string",
          "description": "Fecha de registro YYYY-MM-DD"
        },
        "acquisitionTime": {
          "type": "string",
          "description": "Hora de registro HH:mm"
        },
        "activationDate": {
          "type": ["string", "null"],
          "description": "Fecha de activación al tomar posesión o jugar"
        },
        "activationTime": {
          "type": ["string", "null"],
          "description": "Hora de activación"
        },
        "originComplejoId": {
          "type": "string",
          "description": "ID del complejo de origen"
        },
        "originComplejoName": {
          "type": "string",
          "description": "Nombre del complejo de origen"
        },
        "totalBookings": {
          "type": "number",
          "description": "Total de reservas realizadas"
        },
        "totalMatchesPlayed": {
          "type": "number",
          "description": "Total de partidos jugados"
        },
        "participatedMatches": {
          "type": "number",
          "description": "Partidos participados"
        },
        "lastGameDate": {
          "type": "string",
          "description": "Fecha del último partido jugado"
        },
        "lastGameTime": {
          "type": "string",
          "description": "Hora del último partido jugado"
        },
        "notes": {
          "type": "string",
          "description": "Notas u observaciones del cliente"
        },
        "ownerId": {
          "type": "string",
          "description": "UID del operador que lo dio de alta"
        },
        "adminId": {
          "type": "string",
          "description": "ID de control o cadena vacía"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp ISO de creación"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp ISO de actualización"
        }
      },
      "required": ["id", "name", "originComplejoId", "acquisitionChannel"]
    },
    "Collaborator": {
      "title": "Collaborator",
      "description": "Operador del complejo autenticado mediante Google Auth",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "ID del usuario autenticado"
        },
        "email": {
          "type": "string",
          "description": "Email provisto por Google Auth"
        },
        "name": {
          "type": "string",
          "description": "Nombre provisto por Google Auth (displayName)"
        },
        "photoURL": {
          "type": "string",
          "description": "Foto de perfil provista por Google Auth"
        },
        "activeComplejoId": {
          "type": "string",
          "description": "Complejo seleccionado actualmente para operar"
        },
        "memberships": {
          "type": "array",
          "description": "Membresías del operador { complejoId, complejoName, role }",
          "items": {
            "type": "object",
            "properties": {
              "complejoId": { "type": "string" },
              "complejoName": { "type": "string" },
              "role": { "type": "string" }
            },
            "required": ["complejoId", "complexName", "role"]
          }
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp ISO de creación"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp ISO de actualización"
        }
      },
      "required": ["uid", "email", "activeComplejoId"]
    }
  },
  "firestore": {
    "/complejos/{complejoId}": {
      "schema": "Complejo",
      "description": "Documento central de la sede deportiva con array courts"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Reservas de canchas asociadas a la sede mediante complejoId"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Clientes y jugadores registrados en el complejo"
    },
    "/collaborators/{uid}": {
      "schema": "Collaborator",
      "description": "Perfiles de operadores del complejo"
    }
  }
}
