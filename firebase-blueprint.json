{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "System administrator with privileged access to manage venue settings, matches, and finances",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Administrator email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "superadmin"],
          "description": "Administrator role level"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when admin privilege was granted"
        }
      },
      "required": ["email", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered player or club customer profile",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full display name of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Contact telephone or WhatsApp number"
        },
        "skill_level": {
          "type": "string",
          "enum": ["Principiante", "Amateur", "Intermedio", "Avanzado", "Primera"],
          "description": "Player skill category"
        },
        "rating": {
          "type": "number",
          "description": "Community rating from 1 to 5 stars"
        },
        "matches_played": {
          "type": "number",
          "description": "Total matches played in the venue"
        },
        "created_at": {
          "type": "string",
          "description": "Account registration ISO date"
        },
        "first_visit": {
          "type": "string",
          "description": "First match activation ISO date"
        },
        "last_visit": {
          "type": "string",
          "description": "Last recorded match or visit ISO date"
        }
      },
      "required": ["userId", "name", "email"]
    },
    "Court": {
      "title": "Court",
      "description": "Sports court available for booking at the venue",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Court identifier name (e.g. Cancha 1)"
        },
        "type": {
          "type": "string",
          "maxLength": 50,
          "description": "Sport type, e.g. Fútbol 5, Pádel, Tenis"
        },
        "surface": {
          "type": "string",
          "maxLength": 50,
          "description": "Playing surface type"
        },
        "price_per_hour": {
          "type": "number",
          "description": "Booking rate per hour in local currency"
        },
        "is_roofed": {
          "type": "boolean",
          "description": "Whether the court has a roof"
        },
        "status": {
          "type": "string",
          "enum": ["available", "maintenance"],
          "description": "Operational status of the court"
        }
      },
      "required": ["name", "type", "surface", "price_per_hour", "status"]
    },
    "Match": {
      "title": "Match",
      "description": "Scheduled game or court reservation",
      "type": "object",
      "properties": {
        "court_id": {
          "type": "string",
          "description": "Associated court ID"
        },
        "host_id": {
          "type": "string",
          "description": "Firebase UID or user ID of the host/creator"
        },
        "court_name": {
          "type": "string",
          "description": "Cached court name"
        },
        "host_name": {
          "type": "string",
          "description": "Cached host name"
        },
        "host_phone": {
          "type": "string",
          "description": "Cached host phone"
        },
        "start_time": {
          "type": "string",
          "description": "Start timestamp ISO"
        },
        "end_time": {
          "type": "string",
          "description": "End timestamp ISO"
        },
        "is_open": {
          "type": "boolean",
          "description": "Whether other players can join"
        },
        "mode": {
          "type": "string",
          "description": "Game mode: complete, challenge, missing_players"
        },
        "max_players": {
          "type": "number",
          "description": "Capacity of the match"
        },
        "price_total": {
          "type": "number",
          "description": "Total reservation price"
        },
        "amount_paid": {
          "type": "number",
          "description": "Amount already paid"
        },
        "payment_status": {
          "type": "string",
          "enum": ["pending", "paid", "partial"],
          "description": "Payment status"
        },
        "status": {
          "type": "string",
          "description": "Status of the reservation: scheduled, in_progress, completed, cancelled"
        }
      },
      "required": ["court_id", "host_id", "start_time", "end_time", "max_players", "payment_status", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Income or expense"
        },
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "Category such as Alquiler, Buffet, Torneos, Mantenimiento, Servicios"
        },
        "amount": {
          "type": "number",
          "description": "Monetary value in local currency"
        },
        "date": {
          "type": "string",
          "description": "ISO timestamp of transaction"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Detailed description or notes"
        }
      },
      "required": ["type", "category", "amount", "date"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Support helpdesk ticket or user feedback",
      "type": "object",
      "properties": {
        "ticket_code": {
          "type": "string",
          "maxLength": 20,
          "description": "Unique human-readable ticket code"
        },
        "type": {
          "type": "string",
          "enum": ["bug", "feature", "inquiry", "urgent"],
          "description": "Category of request"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Urgency priority"
        },
        "module": {
          "type": "string",
          "maxLength": 50,
          "description": "Application module where issue occurred"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Short title summary"
        },
        "description": {
          "type": "string",
          "maxLength": 3000,
          "description": "Detailed description of the issue"
        },
        "admin_name": {
          "type": "string",
          "maxLength": 100,
          "description": "Contact name submitting the ticket"
        },
        "admin_email": {
          "type": "string",
          "format": "email",
          "description": "Contact email"
        },
        "admin_phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Contact phone"
        },
        "system_info": {
          "type": "string",
          "maxLength": 1000,
          "description": "Device and browser environment info"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_review", "resolved"],
          "description": "Resolution status"
        },
        "channel": {
          "type": "string",
          "enum": ["whatsapp", "email", "system"],
          "description": "Preferred contact channel"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp ISO"
        }
      },
      "required": ["ticket_code", "type", "priority", "module", "title", "description", "status", "created_at"]
    },
    "VenueProfile": {
      "title": "VenueProfile",
      "description": "General sports venue profile, branding and config",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 150,
          "description": "Venue name"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Venue description"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Venue main phone"
        },
        "instagram": {
          "type": "string",
          "maxLength": 100,
          "description": "Instagram profile handle"
        },
        "address": {
          "type": "string",
          "maxLength": 250,
          "description": "Physical street address"
        }
      },
      "required": ["name"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin authorization documents"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Customer profiles and user records"
    },
    "/courts/{courtId}": {
      "schema": "Court",
      "description": "Sports courts available for booking"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Court bookings and match records"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial income and expense operations"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Technical support and helpdesk tickets"
    },
    "/venue_profile/{venueId}": {
      "schema": "VenueProfile",
      "description": "Venue configuration and business information"
    }
  }
}
