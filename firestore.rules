rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------------
    // Helper Functions for Multi-Tenant Authorization
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in ['aguirrecundo@gmail.com', 'cundooaguirre@gmail.com', 'thekillerpro.fa@gmail.com']
      );
    }

    // Check if the authenticated user has verified membership in complexId
    // activeComplexId is strictly a UI preference and NEVER participates in authorization
    function isCollaboratorOf(complexId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/collaborators/$(request.auth.uid)) &&
          complexId in get(/databases/$(database)/documents/collaborators/$(request.auth.uid)).data.complexIds
        )
      );
    }

    // Check if complex is commercially active:
    // active -> allowed
    // trial && request.time < trialEndsAt -> allowed
    // trial && request.time >= trialEndsAt -> denied
    // paused -> denied
    // inactive -> denied
    function isComplexCommerciallyActive(complexId) {
      let complexPath = /databases/$(database)/documents/complejos/$(complexId);
      return exists(complexPath) && (
        get(complexPath).data.clientStatus == 'active' ||
        (
          get(complexPath).data.clientStatus == 'trial' &&
          'trialEndsAt' in get(complexPath).data &&
          get(complexPath).data.trialEndsAt != null &&
          get(complexPath).data.trialEndsAt is timestamp &&
          request.time < get(complexPath).data.trialEndsAt
        )
      );
    }

    // Enforce both membership AND valid commercial status for operational data
    function hasComplexAccess(complexId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          isCollaboratorOf(complexId) &&
          isComplexCommerciallyActive(complexId)
        )
      );
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Collaborators Collection (User Profiles & Memberships)
    // ------------------------------------------------------------------------
    // A user can read only their own collaborator profile
    match /collaborators/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // SaaS Invitations Collection (One-Time Invite Links)
    // ------------------------------------------------------------------------
    // Single invitation lookup by token is public so an invited user can open /invite/:token
    // Collection listing is strictly restricted to superadmins to prevent enumeration
    match /saasInvitations/{token} {
      allow get: if true;
      allow list: if isSuperAdmin() || (
        isSignedIn() &&
        request.query.limit == 1
      );
      allow create: if isSuperAdmin() || isSignedIn();
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          resource.data.status == 'pending' &&
          request.resource.data.status == 'claimed' &&
          request.resource.data.claimedByUid == request.auth.uid
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Complejos Collection (Venues from ERP)
    // ------------------------------------------------------------------------
    match /complejos/{complexId} {
      allow get: if true; // Public read of venue metadata for invitations and status checks
      allow list: if isSignedIn();
      allow update: if isCollaboratorOf(complexId) || isSuperAdmin() || isSignedIn();
      allow create, delete: if isSuperAdmin();
    }

    match /complexes/{complexId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow update: if isCollaboratorOf(complexId) || isSuperAdmin() || isSignedIn();
      allow create, delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Bookings Collection (Real-Time Agenda Isolated per Complex)
    // ------------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
      allow create: if isSignedIn() && (hasComplexAccess(request.resource.data.complejoId) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
    }

    // Matches / Turnos aliases
    match /matches/{matchId} {
      allow read, write: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
    }

    match /turnos/{turnoId} {
      allow read, write: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Users / Clientes Collection (Clients Isolated per Origin Complex)
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (hasComplexAccess(resource.data.originComplejoId) || isSuperAdmin());
      allow create: if isSignedIn() && (hasComplexAccess(request.resource.data.originComplejoId) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (hasComplexAccess(resource.data.originComplejoId) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Products Collection (Catalog & Inventory Isolated per Complex)
    // ------------------------------------------------------------------------
    match /products/{productId} {
      allow read: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
      allow create: if isSignedIn() && (hasComplexAccess(request.resource.data.complejoId) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Product Categories Collection (Isolated per Complex)
    // ------------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
      allow create: if isSignedIn() && (hasComplexAccess(request.resource.data.complejoId) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Inventory Movements Collection (Immutable Audit History per Complex)
    // ------------------------------------------------------------------------
    match /inventory_movements/{movementId} {
      allow read: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
      allow create: if isSignedIn() && (hasComplexAccess(request.resource.data.complejoId) || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Transactions Collection (POS Sales & Expenses Isolated per Complex)
    // ------------------------------------------------------------------------
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
      allow create: if isSignedIn() && (hasComplexAccess(request.resource.data.complejoId) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Booking Locks Collection (Atomic Mutual Exclusion per Court & Date)
    // ------------------------------------------------------------------------
    match /booking_locks/{lockId} {
      allow read: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
      allow create: if isSignedIn() && (hasComplexAccess(request.resource.data.complejoId) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (hasComplexAccess(resource.data.complejoId) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Support Tickets Collection (Isolated per Complex)
    // ------------------------------------------------------------------------
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.complejoId != null && hasComplexAccess(resource.data.complejoId)) ||
        (resource.data.createdByUid == request.auth.uid) ||
        (resource.data.admin_email == request.auth.token.email)
      );
      allow create: if isSignedIn() && (
        request.resource.data.complejoId == null ||
        hasComplexAccess(request.resource.data.complejoId) ||
        isSuperAdmin()
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.complejoId != null && hasComplexAccess(resource.data.complejoId)) ||
        (resource.data.createdByUid == request.auth.uid)
      );
      allow delete: if isSuperAdmin();
    }
  }
}
