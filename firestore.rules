rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email in ['aguirrecundo@gmail.com', 'TheKillerPRO.FA@gmail.com'])
      );
    }

    // Test connection doc used to verify connection
    match /test/connection {
      allow read: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (isOwner(adminId) || isAdmin());
      allow write: if isAdmin();
    }

    // Complexes collection (activation and properties)
    match /complexes/{complexId} {
      allow read, write: if true;
    }

    // Collaborators collection
    match /collaborators/{collaboratorId} {
      allow read, write: if true;
    }

    // Bookings collection (reservas en tiempo real)
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Matches / Turnos alias
    match /matches/{matchId} {
      allow read, write: if true;
    }

    match /turnos/{turnoId} {
      allow read, write: if true;
    }

    // Users / Clientes collection
    match /users/{userId} {
      allow read, write: if true;
    }

    match /usuarios/{usuarioId} {
      allow read, write: if true;
    }

    // Courts / Canchas collection
    match /courts/{courtId} {
      allow read, write: if true;
    }

    match /canchas/{canchaId} {
      allow read, write: if true;
    }

    // Subcollection: canchas under complex
    match /{path=**}/canchas/{canchaId} {
      allow read, write: if true;
    }

    match /{path=**}/courts/{courtId} {
      allow read, write: if true;
    }

    match /{path=**}/bookings/{bookingId} {
      allow read, write: if true;
    }

    // Venue Profile / Complejo
    match /venue_profile/{venueId} {
      allow read, write: if true;
    }

    match /complejos/{complejoId} {
      allow read, write: if true;
    }

    match /complejo/{complejoId} {
      allow read, write: if true;
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Products collection (Catálogo e Inventario)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categorías de Mostrador
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Historial inmutable de movimientos de inventario
    match /inventory_movements/{movementId} {
      allow read, write: if true;
    }

    // Support tickets
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}
