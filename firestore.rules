rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------------
    // Helper Functions for Multi-Tenant Authorization
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in ['aguirrecundo@gmail.com', 'cundooaguirre@gmail.com', 'thekillerpro.fa@gmail.com']
      );
    }

    // Check if the authenticated user has verified membership in complexId
    // activeComplexId / activeComplejoId or complexIds array
    function isCollaboratorOf(complexId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/collaborators/$(request.auth.uid)) &&
          (
            ('complexIds' in get(/databases/$(database)/documents/collaborators/$(request.auth.uid)).data &&
             complexId in get(/databases/$(database)/documents/collaborators/$(request.auth.uid)).data.complexIds) ||
            ('activeComplejoId' in get(/databases/$(database)/documents/collaborators/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/collaborators/$(request.auth.uid)).data.activeComplejoId == complexId) ||
            ('activeComplexId' in get(/databases/$(database)/documents/collaborators/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/collaborators/$(request.auth.uid)).data.activeComplexId == complexId)
          )
        )
      );
    }

    // Check if complex is commercially active:
    // active -> allowed
    // trial && request.time < trialEndsAt -> allowed
    // trial && request.time >= trialEndsAt -> denied
    // paused -> denied
    // inactive -> denied
    function isComplexCommerciallyActive(complexId) {
      let complexPath = /databases/$(database)/documents/complejos/$(complexId);
      let altComplexPath = /databases/$(database)/documents/complexes/$(complexId);
      return (
        exists(complexPath) && (
          !('clientStatus' in get(complexPath).data) ||
          get(complexPath).data.clientStatus == 'active' ||
          (
            get(complexPath).data.clientStatus == 'trial' &&
            'trialEndsAt' in get(complexPath).data &&
            get(complexPath).data.trialEndsAt != null &&
            get(complexPath).data.trialEndsAt is timestamp &&
            request.time < get(complexPath).data.trialEndsAt
          )
        )
      ) || (
        exists(altComplexPath) && (
          !('clientStatus' in get(altComplexPath).data) ||
          get(altComplexPath).data.clientStatus == 'active' ||
          (
            get(altComplexPath).data.clientStatus == 'trial' &&
            'trialEndsAt' in get(altComplexPath).data &&
            get(altComplexPath).data.trialEndsAt != null &&
            get(altComplexPath).data.trialEndsAt is timestamp &&
            request.time < get(altComplexPath).data.trialEndsAt
          )
        )
      );
    }

    // Enforce both membership AND valid commercial status for operational data
    function hasComplexAccess(complexId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          isCollaboratorOf(complexId) &&
          isComplexCommerciallyActive(complexId)
        )
      );
    }

    // Helper to resolve complex ID from document data regardless of field naming (complexId or complejoId)
    function canAccessDocComplex(data) {
      return (
        ('complexId' in data && data.complexId != null && hasComplexAccess(data.complexId)) ||
        ('complejoId' in data && data.complejoId != null && hasComplexAccess(data.complejoId))
      );
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Collaborators Collection (User Profiles & Memberships)
    // ------------------------------------------------------------------------
    // A user can read only their own collaborator profile
    match /collaborators/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // SaaS Invitations Collection (One-Time Invite Links)
    // ------------------------------------------------------------------------
    // Single invitation lookup by token is public so an invited user can open /invite/:token
    // Collection listing is strictly restricted to superadmins to prevent enumeration
    match /saasInvitations/{token} {
      allow get: if true;
      allow list: if isSuperAdmin() || (
        isSignedIn() &&
        request.query.limit == 1
      );
      allow create: if isSuperAdmin() || isSignedIn();
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          resource.data.status == 'pending' &&
          request.resource.data.status == 'claimed' &&
          request.resource.data.claimedByUid == request.auth.uid
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Complejos / Complexes Collection (Venues from ERP)
    // ------------------------------------------------------------------------
    match /complejos/{complexId} {
      allow get: if true; // Public read of venue metadata for invitations and status checks
      allow list: if isSignedIn();
      allow update: if isCollaboratorOf(complexId) || isSuperAdmin() || isSignedIn();
      allow create, delete: if isSuperAdmin();
    }

    match /complexes/{complexId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow update: if isCollaboratorOf(complexId) || isSuperAdmin() || isSignedIn();
      allow create, delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Bookings Collection (Real-Time Agenda Isolated per Complex)
    // ------------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow create: if isSignedIn() && (canAccessDocComplex(request.resource.data) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
    }

    // Matches / Turnos aliases
    match /matches/{matchId} {
      allow read, write: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
    }

    match /turnos/{turnoId} {
      allow read, write: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Users / Clientes Collection (Clients Isolated per Origin Complex)
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        canAccessDocComplex(resource.data) ||
        ('originComplejoId' in resource.data && hasComplexAccess(resource.data.originComplejoId)) ||
        ('originComplexId' in resource.data && hasComplexAccess(resource.data.originComplexId))
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        canAccessDocComplex(request.resource.data) ||
        ('originComplejoId' in request.resource.data && hasComplexAccess(request.resource.data.originComplejoId)) ||
        ('originComplexId' in request.resource.data && hasComplexAccess(request.resource.data.originComplexId))
      );
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        canAccessDocComplex(resource.data) ||
        ('originComplejoId' in resource.data && hasComplexAccess(resource.data.originComplejoId)) ||
        ('originComplexId' in resource.data && hasComplexAccess(resource.data.originComplexId))
      );
    }

    // ------------------------------------------------------------------------
    // Products Collection (Catalog & Inventory Isolated per Complex)
    // ------------------------------------------------------------------------
    match /products/{productId} {
      allow read: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow create: if isSignedIn() && (canAccessDocComplex(request.resource.data) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Product Categories Collection (Isolated per Complex)
    // ------------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow create: if isSignedIn() && (canAccessDocComplex(request.resource.data) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Inventory Movements Collection (Immutable Audit History per Complex)
    // ------------------------------------------------------------------------
    match /inventory_movements/{movementId} {
      allow read: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow create: if isSignedIn() && (canAccessDocComplex(request.resource.data) || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Complex Counters Collection (Sequential numbering per Complex)
    // ------------------------------------------------------------------------
    match /complex_counters/{complexId} {
      allow read: if isSignedIn() && (hasComplexAccess(complexId) || isSuperAdmin());
      allow create, update: if isSignedIn() && (hasComplexAccess(complexId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Idempotency Keys Collection (Prevent duplicate transactions)
    // ------------------------------------------------------------------------
    match /idempotency_keys/{key} {
      allow get: if isSignedIn() && (
        resource == null ||
        isSuperAdmin() ||
        canAccessDocComplex(resource.data)
      );
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && (canAccessDocComplex(request.resource.data) || isSuperAdmin());
      allow update: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // Operations Collection (Unified Financial Engine: POS Sales, Bookings)
    // ------------------------------------------------------------------------
    match /operations/{operationId} {
      allow read: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow create: if isSignedIn() && (canAccessDocComplex(request.resource.data) || isSuperAdmin());
      allow update: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow delete: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Financial Movements Collection (Cash Flow & Income Movements)
    // ------------------------------------------------------------------------
    match /financial_movements/{movementId} {
      allow read: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow create: if isSignedIn() && (canAccessDocComplex(request.resource.data) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Transactions Collection (Legacy POS Sales & Expenses Isolated per Complex)
    // ------------------------------------------------------------------------
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow create: if isSignedIn() && (canAccessDocComplex(request.resource.data) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Booking Locks Collection (Atomic Mutual Exclusion per Court & Date)
    // ------------------------------------------------------------------------
    match /booking_locks/{lockId} {
      allow read: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
      allow create: if isSignedIn() && (canAccessDocComplex(request.resource.data) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (canAccessDocComplex(resource.data) || isSuperAdmin());
    }

    // ------------------------------------------------------------------------
    // Support Tickets Collection (Isolated per Complex)
    // ------------------------------------------------------------------------
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        canAccessDocComplex(resource.data) ||
        (resource.data.createdByUid == request.auth.uid) ||
        (resource.data.admin_email == request.auth.token.email)
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        canAccessDocComplex(request.resource.data) ||
        request.resource.data.complejoId == null
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        canAccessDocComplex(resource.data) ||
        (resource.data.createdByUid == request.auth.uid)
      );
      allow delete: if isSuperAdmin();
    }
  }
}
