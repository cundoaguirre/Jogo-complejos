rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /test/connection {
      allow read: if true;
    }

    match /complexes/{complexId} {
      allow read, write: if true;
    }

    match /collaborators/{collaboratorId} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /matches/{matchId} {
      allow read, write: if true;
    }

    match /turnos/{turnoId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /usuarios/{usuarioId} {
      allow read, write: if true;
    }

    match /courts/{courtId} {
      allow read, write: if true;
    }

    match /canchas/{canchaId} {
      allow read, write: if true;
    }

    match /{path=**}/canchas/{canchaId} {
      allow read, write: if true;
    }

    match /{path=**}/courts/{courtId} {
      allow read, write: if true;
    }

    match /{path=**}/bookings/{bookingId} {
      allow read, write: if true;
    }

    match /venue_profile/{venueId} {
      allow read, write: if true;
    }

    match /complejos/{complejoId} {
      allow read, write: if true;
    }

    match /complejo/{complejoId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}
